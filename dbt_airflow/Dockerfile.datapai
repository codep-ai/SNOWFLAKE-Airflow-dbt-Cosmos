FROM apache/airflow:2.10.4-python3.11

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential wget && \
    wget -q http://prdownloads.sourceforge.net/ta-lib/ta-lib-0.4.0-src.tar.gz && \
    tar xzf ta-lib-0.4.0-src.tar.gz && cd ta-lib && \
    ./configure --prefix=/usr && make && make install && \
    cd .. && rm -rf ta-lib ta-lib-0.4.0-src.tar.gz && \
    rm -rf /var/lib/apt/lists/*
USER airflow

# Stage 1: dbt-core 1.10 + every adapter aligned at 1.10 so the same image
# can build models against Snowflake / ClickHouse / Athena / DuckDB / Postgres.
# Rationale (2026-06-22): dbt-clickhouse's latest released version is 1.10.1
# (2026-06-17). Aligning everything at 1.10 keeps Iceberg materialization
# from dbt-snowflake + adds the ClickHouse + Athena adapters in one image.
# When dbt-clickhouse 1.11 ships, bump in lock-step.
# Stay on dbt-core 1.11 (the proven base for this image) + dbt-snowflake 1.11
# which fully supports Iceberg materialization. Add dbt-clickhouse 1.10.1
# (latest released; ClickHouse Inc lags one minor behind dbt-core), and
# dbt-athena for the Iceberg-via-Glue read path. dbt-duckdb for local
# experimentation. Dropping dbt-postgres — nobody uses it.
RUN pip install --no-cache-dir \
    dbt-core==1.11.7 \
    dbt-snowflake==1.11.3 \
    dbt-clickhouse==1.10.1 \
    dbt-athena-community==1.9.4 \
    dbt-duckdb==1.10.0

# Stage 2: cosmos
RUN pip install --no-cache-dir astronomer-cosmos==1.13.1

# Stage 3: datapai project deps (matching host requirements)
RUN pip install --no-cache-dir \
    yfinance boto3 psycopg2-binary pandas requests \
    fastapi pydantic openai google-generativeai ta-lib \
    ag2 httpx python-dotenv

# Stage 4: re-pin protobuf to 6.x — google-generativeai 0.8.x pulls
# protobuf 4 transitively, which breaks dbt-core 1.11 + dbt-adapters 1.22
# (both require protobuf >= 6). Install last so it wins the resolver.
RUN pip install --no-cache-dir "protobuf>=6.0,<7.0"
